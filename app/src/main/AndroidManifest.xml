<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Constitution §3: the network is used only to talk to the user's own music server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17: reaching a server on the home network (192.168.x.x) needs the local-network permission (plan §3.5). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Playback runs in a foreground media service (FR-022); the notification permission is asked for just in time. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- FR-062: read the theme, typeface and text size that Athena Launcher publishes (signature-protected). -->
    <uses-permission android:name="se.anders.athenalauncher.permission.READ_APPEARANCE" />
    <queries>
        <provider android:authorities="se.anders.athenalauncher.appearance" />
    </queries>

    <application
        android:name=".AthenaMusicApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Athena">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported so the system (lock screen, headset, Bluetooth) can bind to the media session. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
